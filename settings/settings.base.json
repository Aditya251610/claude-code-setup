{
  "model": "claude-sonnet-5-5",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/target/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/poetry.lock)",
      "Read(**/uv.lock)"
    ]
  }
}
